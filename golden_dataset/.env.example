# Copy to .env and fill in. .env is gitignored and must stay that way.
OPENAI_API_KEY=
GEMINI_API_KEY=

# Optional: tracing. Leave blank to disable.
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=

# Optional: override model names.
# GEMINI_MODEL=gemini-3.6-flash
# OPENAI_AUDIO_MODEL=gpt-audio
# OPENAI_CLASSIFY_MODEL=gpt-5-mini
# WHISPER_MODEL_SIZE=small.en

# Optional: prices used for cost estimates, per million tokens.
# GEMINI_INPUT_PRICE_PER_MILLION=1.50
# OPENAI_AUDIO_INPUT_PRICE_PER_MILLION=32.00
